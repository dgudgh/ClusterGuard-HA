[Unit]
Description=ClusterGuard HA Multi-Database High Availability Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clusterguard
Group=clusterguard
EnvironmentFile=-/etc/clusterguard/clusterguard.env
Environment=PATH=/usr/local/mysql/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/local/bin/clusterguard --config /etc/clusterguard/clusterguard.json
Restart=on-failure
RestartSec=5s
ConfigurationDirectory=clusterguard
ConfigurationDirectoryMode=0750
StateDirectory=clusterguard
StateDirectoryMode=0750
LogsDirectory=clusterguard
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clusterguard /var/log/clusterguard

[Install]
WantedBy=multi-user.target
