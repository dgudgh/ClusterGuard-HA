[Unit]
Description=ClusterGuard HA Multi-Database High Availability Control Plane
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=clusterguard
Group=clusterguard
EnvironmentFile=-/etc/clusterguard/clusterguard.env
Environment=PATH=/usr/local/mysql/bin:/usr/pgsql-16/bin:/usr/lib/postgresql/16/bin:/opt/mssql-tools18/bin:/opt/mssql-tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=/usr/local/bin/clusterguard --config /etc/clusterguard/clusterguard.json --check-config
ExecStart=/usr/local/bin/clusterguard --config /etc/clusterguard/clusterguard.json
Restart=always
RestartSec=5s
TimeoutStopSec=35s
LimitNOFILE=65536
TasksMax=4096
ConfigurationDirectory=clusterguard
ConfigurationDirectoryMode=0750
StateDirectory=clusterguard
StateDirectoryMode=0750
LogsDirectory=clusterguard
# Database service accounts own engine-specific log subdirectories. Keep the
# shared root non-listable while allowing them to traverse to those leaves.
LogsDirectoryMode=0751
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clusterguard /var/log/clusterguard

[Install]
WantedBy=multi-user.target
