[Unit]
Description=ClusterGuard HA Data Node VIP Reconcile
After=network-online.target mysql.service mysqld.service postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/clusterguard/agent.env
ExecStart=/usr/local/bin/clusterguard-agent --config /etc/clusterguard/agent.json --reconcile
StandardOutput=journal
StandardError=journal
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clusterguard-agent -/etc/clusterguard/docker
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
UMask=0077
