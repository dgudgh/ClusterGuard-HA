# Platform administrator passwords are not configured in this file. They are
# stored as Argon2id hashes in the replicated metadata snapshot.
CG_CONTROL_TOKEN=replace-with-a-control-api-secret
CG_MONITORING_TOKEN=replace-with-a-monitoring-read-secret
CG_MYSQL_DISCOVERY_PASSWORD=replace-with-the-read-only-mysql-secret
CG_MYSQL_OPERATION_PASSWORD=replace-with-the-mysql-operation-secret
CG_MYSQL_REPLICATION_PASSWORD=replace-with-the-replication-secret
CG_AGENT_SHARED_SECRET=replace-with-a-random-agent-signing-secret
CG_NODE_SSH_PASSWORD=replace-with-a-transient-bootstrap-password
CG_NODE_MYSQL_ROOT_PASSWORD=replace-with-the-managed-node-root-secret
CG_NODE_MYSQL_REPLICATION_PASSWORD=replace-with-the-managed-node-replication-secret
