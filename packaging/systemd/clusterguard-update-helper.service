[Unit]
Description=ClusterGuard HA Privileged Software Update Helper
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=clusterguard
ExecStart=/usr/local/libexec/clusterguard-update-helper --socket /run/clusterguard/update-helper.sock --root /var/lib/clusterguard/updates --private-root /var/lib/clusterguard-update-private --runner /usr/local/libexec/clusterguard-update-job.sh
Restart=on-failure
RestartSec=3s
# /run/clusterguard is shared with other ClusterGuard runtime state. Do NOT claim it
# via RuntimeDirectory= : systemd would chown/chmod it on every start (a first-start
# race with an existing directory surfaces as exit status 233/RUNTIME_DIRECTORY) and
# would REMOVE it when this unit stops, dropping sockets other components rely on.
# Create it idempotently instead; existing owners/modes are already correct.
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g clusterguard /run/clusterguard
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=false
ReadWritePaths=/run/clusterguard /var/lib/clusterguard/updates /var/lib/clusterguard-update-private /etc/clusterguard /var/lib/clusterguard /var/log/clusterguard
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
